# /etc/teslausb-car-endpoint.env - read by /usr/local/sbin/car-endpoint-refresh
# The home DDNS name the tunnel should follow. The resolved IPv4 is written into
# the tunnel config, teslausb-car-link.ini (wg_endpoint_ip) and car-video.env (WG_ENDPOINT_IP).
CAR_ENDPOINT_NAME=REPLACE_WITH_HOME_DDNS_NAME
# WireGuard interface name (default tun_wg7)
#WG_IF=tun_wg7
