# Primary: Sunshine's Desktop app over the dedicated WireGuard tunnel.
VIDEO_BACKEND=moonlight
MOONLIGHT_HOST=REPLACE_WITH_SUNSHINE_WG_IP
MOONLIGHT_APP=Desktop
# Starting values; adjust after the EVOffer HDMI EDID and LTE measurements.
MOONLIGHT_RESOLUTION=1280x720
MOONLIGHT_FPS=30
MOONLIGHT_BITRATE_KBPS=4000
# Fallback when VIDEO_BACKEND=rtsp:
STREAM_URL=rtsp://REPLACE_WITH_RTSP_WG_IP:8554/house
